# Copy this file to .env and fill in your keys. .env is git-ignored. Environment variables win over it.

# Required: Jev (TypeSafe), which ranks, sorts and tags the photos. Or use Gemini Decision instead
# (see "Gemini Decision instead of Jev" in the README), which only needs GEMINI_API_KEY.
TYPESAFE_API_KEY=

# Optional extra judges; see "Optional: more judges" in the README.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
